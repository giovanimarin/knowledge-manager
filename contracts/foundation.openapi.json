{
  "openapi": "3.1.0",
  "info": { "title": "KnowledgeManager Foundation", "version": "0.1.0" },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "security": [],
        "responses": { "200": { "$ref": "#/components/responses/Healthy" } }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": { "$ref": "#/components/responses/Ready" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Healthy": {
        "description": "Process is alive",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" }, "example": { "status": "ok" } } }
      },
      "Ready": {
        "description": "All dependencies are ready",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ready" }, "example": { "status": "ready" } } }
      },
      "Unavailable": {
        "description": "A dependency is unavailable",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Unavailable" }, "example": { "type": "about:blank", "title": "Service Unavailable", "status": 503 } } }
      }
    },
    "schemas": {
      "Health": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "ok" } } },
      "Ready": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "ready" } } },
      "Unavailable": {
        "type": "object", "additionalProperties": false, "required": ["type", "title", "status"],
        "properties": { "type": { "const": "about:blank" }, "title": { "const": "Service Unavailable" }, "status": { "const": 503 } }
      }
    }
  }
}
